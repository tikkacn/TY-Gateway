# Copy to /etc/ty-frp-auth/ty-frp-auth.env and chmod 0600.
# The token contents belong in separate 0600 files, never in this file.
TY_FRP_ROSTER_URL=https://cloud.example.invalid/api/v1/frp/roster
TY_FRP_ROSTER_TOKEN_FILE=/etc/ty-frp-auth/roster-api.token
TY_FRP_ROSTER_CACHE=/var/lib/ty-frp-auth/roster.json
TY_FRP_AUTH_LISTEN=127.0.0.1:9081
TY_FRP_PORT_START=22000
TY_FRP_PORT_END=22999
