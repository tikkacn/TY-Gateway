# Local development uses memory storage when TY_DB_DSN is empty.
# Production: point this at the existing aaPanel MariaDB/MySQL instance.
TY_LISTEN_ADDR=127.0.0.1:9080
TY_DB_DSN=tygateway:change-me@tcp(127.0.0.1:3306)/tygateway?parseTime=true&charset=utf8mb4
TY_ADMIN_TOKEN=replace-with-a-long-random-token
TY_ADMIN_PASSWORD=replace-with-a-unique-admin-password
# Optional: enables support-signed, device-bound local password recovery.
# Keep the Ed25519 private key only in the protected Cloud environment file.
# OEC devices will need the matching public key in their local manager before
# any issued authorization can be accepted.
# TY_RECOVERY_KEY_ID=support-2026-01
# TY_RECOVERY_SIGNING_KEY=<64-byte Ed25519 private key, hex/base64>
# 32-byte key as hex or base64. Required for production subscription storage.
TY_SUBSCRIPTION_KEY=replace-with-64-hex-characters
TY_OFFLINE_AFTER=90s
TY_RULE_CACHE_DIR=/var/lib/tygateway/rules
TY_ALLOW_HTTP_SUBSCRIPTIONS=0
# FRP control traffic uses the same port on both sides: FRPS bindPort and
# FRPC serverPort. Reconfigure the 7001 listener for per-device plugin auth;
# remote SSH mappings use 22000-22999. Never put roster tokens in this repo.
TY_FRPS_HOST=frps.example.invalid
TY_FRPS_CONTROL_PORT=7001
TY_FRPS_REMOTE_PORT_START=22000
TY_FRPS_REMOTE_PORT_END=22999
TY_FRP_AUTO_ENABLED=1
TY_FRP_AUTO_CA_FILE=/etc/tygateway/frp-auto-ca.pem
TY_FRP_ROSTER_TOKEN=replace-with-a-dedicated-random-token-at-least-32-characters
# TY_RESCUE_HOST is retired and must not be set.
