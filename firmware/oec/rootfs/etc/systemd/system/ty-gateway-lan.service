[Unit]
Description=TY Gateway LAN DHCP and DNS
After=network-online.target ty-gateway-network.service systemd-tmpfiles-setup.service
Wants=network-online.target
ConditionPathExists=/var/lib/ty-gateway-network/lan.conf

[Service]
Type=forking
EnvironmentFile=-/etc/ty-gateway/local.env
User=root
Group=root
PIDFile=/run/ty-gateway-lan/dnsmasq.pid
RuntimeDirectory=ty-gateway-lan
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/python3 /usr/local/libexec/ty_gateway_lan.py prepare
ExecStart=/usr/sbin/dnsmasq --conf-file=/var/lib/ty-gateway-network/lan.conf --pid-file=/run/ty-gateway-lan/dnsmasq.pid --user=root --group=root
ExecStopPost=/usr/bin/python3 /usr/local/libexec/ty_gateway_lan.py stop
Restart=on-failure
RestartSec=5
TimeoutStartSec=35
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID
ReadWritePaths=/var/lib/ty-gateway-network /run/ty-gateway-lan /run/xtables.lock
UMask=0077
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
