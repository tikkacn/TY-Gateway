[Unit]
Description=Initialize the TY Gateway OEC runtime user
After=local-fs.target
Before=ty-gateway-agent.service
ConditionPathExists=!/var/lib/ty-gateway/.initialized

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/ty-gateway-firstboot
RemainAfterExit=yes
NoNewPrivileges=false
# This one-shot creates system users and writes /etc/ty-gateway.
# Do not make /etc read-only for this service.
ProtectHome=true

[Install]
WantedBy=multi-user.target
