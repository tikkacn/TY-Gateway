# Copy to /etc/ty-gateway/agent.env on the OEC. Do not put credentials here.
TY_CLOUD_URL=https://oec.188811.xyz
TY_AGENT_STATE_DIR=/var/lib/ty-gateway
# Leave blank to select the interface with the active IPv4 default route.
# Set explicitly only on multi-interface devices where the intended LAN port
# is not the default-route interface.
TY_AGENT_INTERFACE=
TY_AGENT_INTERVAL=30s
TY_AGENT_CONFIG_EVERY=60s
# Fresh devices generate and durably save a random per-device identity locally,
# then claim only a matching, administrator-pre-registered MAC over HTTPS.
# Existing agent.env files are preserved on upgrade. Never put shared FRP or
# Cloud secrets in this file or in the generic installation package.
TY_AGENT_AUTO_ENROLL=1
# Cloud proxy switches are staged only. Do not remove the systemd safety gate
# until OEC routing has been tested on-site and deliberately approved.
