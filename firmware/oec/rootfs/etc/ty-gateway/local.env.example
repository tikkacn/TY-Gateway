# Local-only web manager. Until mDNS is verified on the target image, use
# http://<OEC-LAN-IP>:8088. The default does not conflict with HTTP admin ports.
TY_LOCAL_LISTEN_ADDR=:8088
TY_LOCAL_STATE_DIR=/var/lib/ty-gateway-local
TY_LOCAL_UPDATE_SOCKET=/run/ty-gateway-update/control.sock
# Leave blank to select the interface with the active IPv4 default route.
# Set explicitly only when the LAN-facing interface is different.
TY_LOCAL_INTERFACE=
# The installer fills this from the selected interface's MAC. It is an
# identifier only, never a password or recovery credential.
# TY_LOCAL_DEVICE_CODE=AABBCCDDEEFF

# Offline password recovery is unavailable until the matching public key is
# deliberately provisioned. Never put the private signing key on an OEC.
# TY_RECOVERY_KEY_ID=production-v1
# TY_RECOVERY_PUBLIC_KEY=<Ed25519 public key in base64 or hex>
